{
  "name": "@rainronin/dsh-balance-monitor",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：DeepSeek API 余额实时监测（官方 /user/balance 快照 + ds_balance 工具 + 峰谷计价状态 + Matrix/原生双风格侧边栏徽章）",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "balance",
    "plugin",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rainronin/dsh-balance-monitor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./typert/typert-host.d.ts",
      "default": "./typert/typert-host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "typert",
    "cordis.patch.yml",
    "assets",
    "docs/UI设计构思.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && tsc -p tsconfig.client.json && node scripts/wrap-client.mjs && node scripts/verify-client.mjs && node scripts/verify-typert.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3"
  }
}
